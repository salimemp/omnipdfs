{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "upload",
        "download",
        "convert",
        "share",
        "delete",
        "merge",
        "split",
        "compress",
        "protect"
      ],
      "description": "Type of activity"
    },
    "document_id": {
      "type": "string"
    },
    "document_name": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "description": "Additional action details"
    },
    "ip_address": {
      "type": "string"
    }
  },
  "required": [
    "action"
  ]
}